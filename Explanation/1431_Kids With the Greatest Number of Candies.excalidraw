    {
      "id": "fujgWLBfgDXnOeUknb6sp",
      "type": "text",
      "x": 395.0512821753172,
      "y": 1630.478238923415,
      "width": 1128.3712158203125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
