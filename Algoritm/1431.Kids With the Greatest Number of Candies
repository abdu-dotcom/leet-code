class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        // int array result
        ArrayList<Boolean> output = new ArrayList<Boolean>(candies.length); // variable output bisa didefine length yg dibutuhkan, jadi lebih ringan

        int max = 0;

        // loop untuk mendapatkan nilai tertinggi
        for(int candy: candies){
            if (max < candy){max = candy;};
        }
        // mencari anak mana yg memiliki permen terbanyak dari yg paling banyak setelah ditambah extra permen
        for(int candie: candies){
            if(candie + extraCandies >= max) {output.add(true);}     // memperbaiki code yang berulang, menjadi lebih singkat dan mudah dibaca
            else { output.add(false);};
        }
        return output;
    }
}