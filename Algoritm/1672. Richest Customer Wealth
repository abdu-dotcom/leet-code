// clean code program according to chatgpt.
// variable wealth becomes maxWealth -> stores the highest value of customer asstes
// variable sumWealth becomes total -> the total assets owned by customer
// for loop becomes foreach -> more cleaner code.

class Solution {
    public int maximumWealth(int[][] accounts) {
        int maxWealth = 0;

        for(int[] customer : accounts){
            int total = 0;
            for(int money : customer){
                total += money;
            }
            maxWealth = Math.max(maxwealth, total);
        }
        return maxWealth;
    }
}