// question test -> https://leetcode.com/problems/richest-customer-wealth/description/

class Solution {
    public int maximumWealth(int[][] accounts) {
        int wealth = 0;

        for(int i = 0; i < accounts.length; i++){
            int sumWealth = 0;
            for(int j = 0; j < accounts[i].length; j++){
                sumWealth = sumWealth + accounts[i][j];
            }
            if (wealth < sumWealth) {
                wealth = sumWealth;
            }
        }
        return wealth;
    }
}