class Solution {
    public List<String> fizzBuzz(int n) {
         List<String> answer = new ArrayList<String>();

        for(int number = 1; number <= n; number++){
            if(number % 3 == 0 && number % 5 == 0){         // answer[i] == "FizzBuzz" if i is divisible by 3 and 5.
                answer.add("FizzBuzz");
            } else if (number % 3 == 0) {                   // answer[i] == "Fizz" if i is divisible by 3.
                answer.add("Fizz");
            } else if (number % 5 == 0) {                   // answer[i] == "Buzz" if i is divisible by 5.
                answer.add("Buzz");
            } else {                                        // answer[i] == i (as a string) if none of the above conditions are true.
                answer.add(Integer.toString(number));
            }
        }
        return answer;
    }
}