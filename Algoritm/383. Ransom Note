class Solution {
    public boolean canConstruct(String ransomNote, String magazine) {
        boolean output = false;
        StringBuilder ransomNoteArray = new StringBuilder(new String(ransomNote)); // ['a','a','b']
        StringBuilder magazineArray = new StringBuilder(new String(magazine)); // ['b','a','a']
        StringBuilder temp = new StringBuilder();

        for(int i=0; i < ransomNoteArray.length(); i++){
            for(int j=0; j < magazineArray.length(); j++){
                if(ransomNoteArray.charAt(i) == magazineArray.charAt(j)){ // a <=> a
                    if(temp.length() == 0){
                        temp.append(ransomNoteArray.charAt(i));
                        magazineArray.setCharAt(j, '0');
                    }else{
                        if(temp.length()-1 != i){
                            temp.append(ransomNoteArray.charAt(i));
                            magazineArray.setCharAt(j, '0');
                        }
                    }
                }
            }
        }
        if (temp.toString().equals(ransomNoteArray.toString())){
            output = true;
        }
        return output;
    }
}
